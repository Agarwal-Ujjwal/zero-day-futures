# Copy this file to .env.local for local development and fill in real values.
# Never commit the filled-in file -- .gitignore already excludes .env* except this example.

# --- Public (exposed to the browser, must stay non-sensitive) ---
NEXT_PUBLIC_APTOS_NETWORK=testnet
NEXT_PUBLIC_MODULE_ADDRESS=
NEXT_PUBLIC_APTOS_API_KEY=

# --- Server-only secrets (never prefix these with NEXT_PUBLIC_) ---
APTOS_INDEXER_URL=
APTOS_INDEXER_API_KEY=
# Pyth is discontinued on Aptos (docs/architecture.md) - the keeper posts its own
# off-chain price via oracle::post_price instead. Set this once lib/oracle picks
# a price source (e.g. a public price API) for the keeper to read from.
PRICE_SOURCE_API_KEY=
KEEPER_PRIVATE_KEY=
CRON_SECRET=
DATABASE_URL=
